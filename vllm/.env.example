# OpenAI API 설정
OPENAI_API_KEY=your-openai-api-key-here

# 백엔드 서버 POST URL
FINETUNING_POST_URL=http://localhost:8000/api/v1/influencers/finetuning/result

# 파인튜닝 멀티프로세싱 설정
USE_FINETUNING_MULTIPROCESSING=true

# GPU 설정
VLLM_GPU_ID=0
VLLM_GPU_MEMORY_UTILIZATION=0.5

# 파인튜닝 GPU 설정
FINETUNING_GPU_ID=2

# PyTorch 메모리 최적화
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512