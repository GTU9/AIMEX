# Zonos TTS Worker 환경 변수 예시

# Hugging Face 모델 캐시 디렉토리
HF_HOME=/workspace/huggingface

# 로깅 레벨 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# GPU 메모리 최적화 설정
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# 모델 설정
MODEL_NAME=Zyphra/Zonos-v0.1-transformer
DEVICE=cuda:0

# 성능 설정
MAX_TEXT_LENGTH=500
DEFAULT_SPEAKING_RATE=22.0
DEFAULT_PITCH_STD=40.0
DEFAULT_CFG_SCALE=4.0

# Backend POST URL (TTS 완료 시 전송)
BACKEND_POST_URL=http://your-backend-url/api/v1/tts/result