# RunPod 파인튜닝 워커 환경 변수

# Backend POST URL (파인튜닝 완료 시 전송)
BACKEND_POST_URL=http://your-backend-url/api/v1/influencers/finetuning/result

# Hugging Face 모델 캐시 디렉토리
HF_HOME=/workspace/huggingface

# GPU 메모리 최적화 설정
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# 로깅 레벨 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO