# ===========================================================================
# 백엔드 컨테이너 런타임 환경변수 (FastAPI / config.py 가 읽음)
#   cp backend.env.example backend.env  후 실제 값 기입. backend.env 는 커밋 금지.
#   ⚠️ env_file 은 ${...} 치환을 하지 않는다 → 실제 값을 직접 적을 것.
# ===========================================================================

# --- 데이터베이스 (compose 의 db 서비스, 호스트명 = db) ---
# .env 의 DB_ROOT_PW 와 동일한 비밀번호를 직접 기입.
DATABASE_URL=mysql+pymysql://root:change-this-strong-db-password@db:3306/AIMEX_MAIN
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# --- 보안 ---
JWT_SECRET_KEY=change-this-long-random-secret
SECRET_KEY=change-this-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- 앱/서버 ---
ENVIRONMENT=production
DEBUG=false
APP_NAME=AIMEX Backend
HOST=0.0.0.0
PORT=8000
RELOAD=false
ENABLE_DOCS=true
BACKEND_URL=https://api.example.com

# --- CORS (Cloudflare 의 프론트 도메인) ---
CORS_ALLOW_CREDENTIALS=true
ALLOWED_ORIGINS=https://portfolio.example.com

# ===========================================================================
# 스토리지: MinIO (S3 호환)
#   ⚠️ AWS_S3_ENDPOINT 는 코드 변경(배포계획 4-2: boto3 client 에 endpoint_url
#      주입)이 선행되어야 적용된다. 변경 전에는 AWS S3 로만 동작.
# ===========================================================================
S3_ENABLED=true
AWS_S3_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=aimex-minio-admin
AWS_SECRET_ACCESS_KEY=change-this-strong-minio-password
S3_BUCKET_NAME=aimex
AWS_REGION=us-east-1

# ===========================================================================
# GPU 추론 = RunPod Serverless (온디맨드). 엔드포인트 ID 만 채우면 됨.
#   VLLM 직접 구동은 비활성(RunPod HTTP 클라이언트 경유).
# ===========================================================================
VLLM_ENABLED=false
RUNPOD_API_KEY=paste-runpod-api-key
RUNPOD_GENERATION_ENDPOINT_ID=
RUNPOD_EMBEDDING_ENDPOINT_ID=
RUNPOD_FINETUNING_ENDPOINT_ID=
RUNPOD_TTS_ENDPOINT_ID=
# 기존 코드 호환용 TTS 엔드포인트 변수 (RUNPOD_TTS_ENDPOINT_ID 와 동일 값)
RUNPOD_ENDPOINT_ID=
USE_RUNPOD_FINETUNING=true

# --- 파인튜닝 베이스 모델 ---
FINETUNING_BASE_MODEL=LGAI-EXAONE/EXAONE-3.5-2.4B-Instruct

# ===========================================================================
# 외부 API (선택 — 없으면 해당 기능 데모/스텁)
# ===========================================================================
# OpenAI (말투/QA/콘텐츠 생성)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_MONITORING_MODE=polling
OPENAI_POLLING_INTERVAL_MINUTES=7

# HuggingFace (LoRA/모델 업로드·다운로드)
HUGGINGFACE_API_URL=https://api.huggingface.co
HUGGINGFACE_TIMEOUT=30

# 소셜 로그인 (백엔드 social_auth 검증용 — 시크릿 포함)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=

# 로깅
LOG_LEVEL=INFO
