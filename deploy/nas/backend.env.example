# ===========================================================================
# 백엔드 컨테이너 런타임 환경변수 (FastAPI / config.py 가 읽음)
#   cp backend.env.example backend.env  후 실제 값 기입. backend.env 는 커밋 금지.
#   ⚠️ env_file 은 ${...} 치환을 하지 않는다 → 실제 값을 직접 적을 것.
# ===========================================================================

# --- 데이터베이스 (compose 의 db 서비스, 호스트명 = db) ---
# .env 의 DB_ROOT_PW 와 동일한 비밀번호를 직접 기입.
DATABASE_URL=mysql+pymysql://root:change-this-strong-db-password@db:3306/AIMEX_MAIN
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# --- 보안 ---
JWT_SECRET_KEY=change-this-long-random-secret
SECRET_KEY=change-this-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- 앱/서버 ---
ENVIRONMENT=production
DEBUG=false
APP_NAME=AIMEX Backend
HOST=0.0.0.0
PORT=8000
RELOAD=false
ENABLE_DOCS=true
BACKEND_URL=https://api.example.com

# --- CORS (Cloudflare 의 프론트 도메인) ---
CORS_ALLOW_CREDENTIALS=true
ALLOWED_ORIGINS=https://portfolio.example.com

# ===========================================================================
# 저장소: NAS 외부 볼륨 마운트 (로컬 파일시스템). AWS S3/MinIO 사용 안 함.
#   이미지/음성은 LOCAL_STORAGE_PATH 에 저장되고 LOCAL_STORAGE_BASE_URL 로 서빙된다.
#   docker-compose 가 이 경로(/app/uploads/images)를 외부 볼륨에 마운트한다.
# ===========================================================================
IMAGE_STORAGE_TYPE=local
LOCAL_STORAGE_PATH=/app/uploads/images
LOCAL_STORAGE_BASE_URL=/api/v1/images
S3_ENABLED=false
# Instagram 등 외부 API가 로컬 저장 이미지에 접근하려면 공개 절대 URL 접두어가 필요.
# 미설정 시 BACKEND_URL 로 폴백. (예: https://api.example.com)
PUBLIC_BASE_URL=https://api.example.com

# ===========================================================================
# GPU 추론 = Modal 서버리스 (온디맨드). RunPod 대신 Modal 사용.
#   modal deploy 후 발급된 함수 URL을 기입. GPU_PROVIDER=modal 로 분기.
# ===========================================================================
GPU_PROVIDER=modal
MODAL_GENERATION_URL=https://your-workspace--aimex-generation-generate.modal.run
MODAL_TTS_URL=https://your-workspace--aimex-tts-tts.modal.run
MODAL_FINETUNING_URL=https://your-workspace--aimex-finetuning-finetune.modal.run
# Modal proxy auth 토큰 (엔드포인트를 비공개로 보호한 경우). 공개면 비워둠.
MODAL_AUTH_TOKEN=
VLLM_ENABLED=false

# --- 파인튜닝 베이스 모델 / HuggingFace ---
FINETUNING_BASE_MODEL=LGAI-EXAONE/EXAONE-3.5-2.4B-Instruct
HUGGINGFACE_API_URL=https://api.huggingface.co
HUGGINGFACE_TIMEOUT=30

# ===========================================================================
# 외부 API
# ===========================================================================
# OpenAI (말투/QA/콘텐츠 생성) — 보유 키 기입
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_MONITORING_MODE=polling
OPENAI_POLLING_INTERVAL_MINUTES=7

# 소셜 로그인 (백엔드 social_auth 검증용 — 시크릿 포함)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=

# 로깅
LOG_LEVEL=INFO
