# ===========================================================================
# 프론트엔드 컨테이너 런타임 환경변수 (Next.js / NextAuth 서버사이드)
#   cp frontend.env.example frontend.env  후 실제 값 기입. frontend.env 는 커밋 금지.
#
#   주의: NEXT_PUBLIC_* 값은 "빌드타임"에 번들에 박힌다.
#         → 그 값들은 docker-compose 의 build.args(=루트 .env)에서 주입한다.
#         이 파일에는 NextAuth 등 "런타임 서버" 변수를 둔다.
# ===========================================================================

# NextAuth (서버 런타임)
NEXTAUTH_URL=https://portfolio.example.com
NEXTAUTH_SECRET=change-this-long-random-secret

# 서버사이드에서 백엔드 직접 호출용 (브라우저 비노출)
BACKEND_URL=https://api.example.com

# 참고: 아래 NEXT_PUBLIC_* 는 빌드 시 .env(build.args)로 박히므로 여기 값은
#       런타임에 영향이 없다. 일관성을 위해 동일 값을 적어두어도 무방.
NEXT_PUBLIC_BACKEND_URL=https://api.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
