# ===========================================================================
# docker-compose 최상위 변수 (compose 가 ${...} 로 치환)
#   cp .env.example .env  후 실제 값 기입. 이 파일(.env)은 커밋 금지.
# ===========================================================================

# --- DB (MariaDB) ---
DB_ROOT_PW=change-this-strong-db-password

# --- MinIO (S3 호환 스토리지) ---
MINIO_USER=aimex-minio-admin
MINIO_PW=change-this-strong-minio-password

# --- Cloudflare Tunnel 토큰 (Zero Trust > Tunnels 에서 발급) ---
CF_TUNNEL_TOKEN=paste-your-cloudflare-tunnel-token

# --- 프론트 빌드 시 박히는 공개 API URL (Cloudflare Ingress 의 api 서브도메인) ---
PUBLIC_API_URL=https://api.example.com

# --- 소셜 로그인 공개 값 (프론트 build-arg, 선택) ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=https://portfolio.example.com/api/auth/callback/google
NEXT_PUBLIC_NAVER_CLIENT_ID=
NEXT_PUBLIC_NAVER_REDIRECT_URI=https://portfolio.example.com/api/auth/callback/naver
NEXT_PUBLIC_INSTAGRAM_APP_ID=
NEXT_PUBLIC_INSTAGRAM_REDIRECT_URI=https://portfolio.example.com/api/auth/callback/instagram
